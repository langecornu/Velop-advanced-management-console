{
  "name": "velop-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Local web tool that unlocks extra Linksys Velop capabilities through its JNAP API",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "probe": "node scripts/probeActions.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test \"server/**/*.test.js\" \"client/src/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
