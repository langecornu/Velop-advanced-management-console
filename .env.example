# Router admin password (required). The account is "admin" unless ROUTER_USER is set.
ROUTER_PASSWORD=

# Password other devices on the network must enter (8+ characters, any user name). Required while BIND_ADDRESS
# is not 127.0.0.1. Requests from this computer are exempt.
ACCESS_PASSWORD=

# Optional. Defaults are shown.
# ROUTER_HOST=192.168.1.1
# ROUTER_USER=admin
# PORT=3001
# BIND_ADDRESS=0.0.0.0        (use 127.0.0.1 to keep the tool on this computer only)
# ALLOWED_ORIGIN=http://localhost:5173
# REQUEST_TIMEOUT_MS=30000
# DATA_DIR=./data
